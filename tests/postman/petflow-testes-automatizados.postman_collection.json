{
  "info": {
    "name": "PetFlow - Testes automatizados (Compliance Sprint 4)",
    "description": "Parte B do plano de testes: 5 casos automatizados contra o Web App publicado. Gerada por tests/postman/gerar_colecao.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// E-mail unico por execucao: o e-mail do tutor e UNIQUE no banco.",
          "if (!pm.collectionVariables.get('emailTutor')) {",
          "    pm.collectionVariables.set('emailTutor', `qa.auto.${Date.now()}@exemplo.com`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "senhaTutor",
      "value": "Clyvo@2026"
    },
    {
      "key": "emailTutor",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenTutor",
      "value": ""
    },
    {
      "key": "tutorId",
      "value": ""
    },
    {
      "key": "petId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CA01 - Saude e autenticacao",
      "item": [
        {
          "name": "Aplicacao no ar e conectada ao banco",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('status UP (inclui o datasource Oracle)', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login do colaborador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailColaborador}}\",\n  \"senha\": \"{{senhaColaborador}}\",\n  \"tipo\": \"COLABORADOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test('emite accessToken', () => pm.expect(corpo.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('colaborador nao recebe refreshToken', () => pm.expect(corpo.refreshToken).to.be.null);",
                  "pm.test('perfil COLABORADOR', () => pm.expect(corpo.tipo).to.eql('COLABORADOR'));",
                  "pm.collectionVariables.set('token', corpo.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CA02 - Cadastro e alteracao de tutor e pet",
      "item": [
        {
          "name": "Cadastrar tutor (rota publica)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tutores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tutores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tutor Automacao QA\",\n  \"email\": \"{{emailTutor}}\",\n  \"telefone\": \"11944443333\",\n  \"senha\": \"{{senhaTutor}}\",\n  \"canalPreferencial\": \"APP\",\n  \"clinicaId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const corpo = pm.response.json();",
                  "pm.test('devolve o id gerado', () => pm.expect(corpo.id).to.be.a('number'));",
                  "pm.test('grava nome e canal', () => {",
                  "    pm.expect(corpo.nome).to.eql('Tutor Automacao QA');",
                  "    pm.expect(corpo.canalPreferencial).to.eql('APP');",
                  "});",
                  "pm.collectionVariables.set('tutorId', corpo.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar pet do tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Bolt\",\n  \"dtNascimento\": \"2022-01-20\",\n  \"sexo\": \"M\",\n  \"porte\": \"MEDIO\",\n  \"castrado\": false,\n  \"status\": \"ATIVO\",\n  \"tutorId\": {{tutorId}},\n  \"racaId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const corpo = pm.response.json();",
                  "pm.test('pet vinculado ao tutor', () => pm.expect(corpo.tutorId).to.eql(Number(pm.collectionVariables.get('tutorId'))));",
                  "pm.test('status ATIVO', () => pm.expect(corpo.status).to.eql('ATIVO'));",
                  "pm.collectionVariables.set('petId', corpo.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Alterar o nome do pet",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pets/{{petId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pets",
                "{{petId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Bolt Veloz\",\n  \"dtNascimento\": \"2022-01-20\",\n  \"sexo\": \"M\",\n  \"porte\": \"MEDIO\",\n  \"castrado\": false,\n  \"status\": \"ATIVO\",\n  \"tutorId\": {{tutorId}},\n  \"racaId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('nome alterado', () => pm.expect(pm.response.json().nome).to.eql('Bolt Veloz'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CA03 - Validacao e integridade",
      "item": [
        {
          "name": "Recusar pet sem campos obrigatorios",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"\",\n  \"dtNascimento\": \"2022-01-20\",\n  \"sexo\": \"M\",\n  \"porte\": \"MEDIO\",\n  \"castrado\": false,\n  \"status\": \"ATIVO\",\n  \"racaId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "const erros = pm.response.json().errors;",
                  "pm.test('aponta o nome em branco', () => pm.expect(erros.nome).to.eql('must not be blank'));",
                  "pm.test('aponta o tutor ausente', () => pm.expect(erros.tutorId).to.eql('must not be null'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recusar exclusao de tutor com pet vinculado",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tutores/{{tutorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tutores",
                "{{tutorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409, nunca 500', () => pm.response.to.have.status(409));",
                  "pm.test('conflito de integridade', () => pm.expect(pm.response.json().title).to.eql('Data Conflict'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CA04 - Controle de acesso por perfil",
      "item": [
        {
          "name": "Login do tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailTutor}}\",\n  \"senha\": \"{{senhaTutor}}\",\n  \"tipo\": \"TUTOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test('perfil TUTOR', () => pm.expect(corpo.tipo).to.eql('TUTOR'));",
                  "pm.test('tutor recebe refreshToken', () => pm.expect(corpo.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('tokenTutor', corpo.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Tutor barrado na API de gestao",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTutor}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tutores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tutores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tutor ve apenas os proprios pets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTutor}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tutor/pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tutor",
                "pets"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('somente o pet Bolt Veloz', () => {",
                  "    const nomes = pm.response.json().content.map(p => p.nome);",
                  "    pm.expect(nomes).to.eql(['Bolt Veloz']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CA05 - Exclusao na ordem correta",
      "item": [
        {
          "name": "Excluir o pet",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pets/{{petId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pets",
                "{{petId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir o tutor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tutores/{{tutorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tutores",
                "{{tutorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tutor excluido nao e mais encontrado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tutores/{{tutorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tutores",
                "{{tutorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "// limpa o e-mail para a proxima execucao gerar outro",
                  "pm.collectionVariables.set('emailTutor', '');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
