# Modelo das variaveis de ambiente da aplicacao.
#
# Copie para .env e preencha com os valores reais. O .env esta no .gitignore
# e nunca deve ser versionado — este arquivo existe justamente para que o
# repositorio documente QUAIS segredos sao necessarios sem carregar nenhum.
#
#   cp .env.example .env

# Porta HTTP. A plataforma de deploy normalmente injeta a sua.
PORT=8080

# Oracle. Em desenvolvimento, o schema compartilhado da FIAP.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
SPRING_DATASOURCE_USERNAME=rmXXXXXX
SPRING_DATASOURCE_PASSWORD=troque-me

# Chave HMAC do JWT. Precisa de pelo menos 32 bytes para HS256 — gere uma
# aleatoria por ambiente e nunca reaproveite a de desenvolvimento em producao:
#   openssl rand -base64 48
JWT_SECRET=troque-me-por-uma-chave-aleatoria-de-no-minimo-32-bytes

# Origens autorizadas a chamar /api de dentro de um navegador, separadas por
# virgula. Deixe vazio quando so o aplicativo nativo consome a API.
# Nunca use "*": com credenciais habilitadas o navegador recusa o curinga.
CORS_ALLOWED_ORIGINS=

# Qual provedor de LLM atende o agente de agendamento: "gemini" (padrao) ou
# "anthropic". Definido em application.properties por clyvo.agente.provedor;
# so preencha a chave do provedor ativo.

# Chave da API do Google Gemini, provedor ativo. A aplicacao sobe sem ela — nesse
# caso /api/agente/** responde 503 e o restante do sistema funciona normalmente.
# Gere em aistudio.google.com/apikey.
GEMINI_API_KEY=

# Chave da API da Anthropic, usada apenas se clyvo.agente.provedor=anthropic.
# Gere em console.anthropic.com.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# Somente para `docker compose up` (banco Oracle em container local).
# A aplicacao nao le estas duas: quem le e o container do banco, e o
# compose reaproveita APP_USER_PASSWORD em SPRING_DATASOURCE_PASSWORD.
#
# Em nuvem nada disto e usado: os scripts 05 e 06 leem os valores do
# Azure Key Vault e os injetam por --secure-environment-variables.
# ---------------------------------------------------------------------

# Senha do SYS/SYSTEM do Oracle no container
ORACLE_PASSWORD=

# Senha do usuario petflow, criado pelo entrypoint da imagem
APP_USER_PASSWORD=
